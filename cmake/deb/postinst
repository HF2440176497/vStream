#!/bin/bash
set -e

PREFIX="/usr/local/vstream"
MANIFEST="${PREFIX}/share/vstream/dep-manifest.txt"
CONF="/etc/ld.so.conf.d/vstream.conf"

reuse_dirs=""          # 目标机已有库的目录（高优先级）
fallback_count=0       # 回退到 dev/lib 的依赖数
version_mismatch=""    # SONAME 不一致的告警列表

if [ -f "${MANIFEST}" ]; then
  while IFS=$'\t' read -r soname build_dir; do
    # 跳过注释与空行
    [[ "${soname}" =~ ^# ]] && continue
    [ -z "${soname}" ] && continue

    if [ -e "${build_dir}/${soname}" ]; then
      # 目标机在同路径有同 SONAME 库 → 复用
      reuse_dirs="${reuse_dirs}${build_dir}\n"
    else
      # 目标机没有 → 用 dev/lib 打包副本
      fallback_count=$((fallback_count + 1))
      # 检查同目录是否有不同版本
      base=$(echo "${soname}" | sed -E 's/\.so\..*//')   # libopencv_core
      if ls "${build_dir}/${base}.so."* >/dev/null 2>&1; then
        existing=$(ls "${build_dir}/${base}.so."* 2>/dev/null | head -1)
        version_mismatch="${version_mismatch}  ${soname} (expected) vs ${existing##*/} (on target, different SONAME)\n"
      fi
    fi
  done < "${MANIFEST}"
else
  echo "Note: dep-manifest.txt not found at ${MANIFEST}"
  echo "      Skipping adaptive reuse — all deps resolved via vstream/lib and dev/lib."
fi

# 去重复用目录
reuse_dirs=$(printf "%b" "${reuse_dirs}" | sort -u | grep -v '^$' || true)

# 生成 ld.so.conf.d/vstream.conf
{
  echo "# vStream - generated by postinst, do not edit manually"
  echo "# (1) Reuse directories: system libs found at compile-time paths (high priority)"
  printf "%s\n" "${reuse_dirs}"
  echo "# (2) vStream own libraries"
  echo "${PREFIX}/lib"
  echo "# (3) Bundled third-party fallback (used only if not found in (1))"
  echo "${PREFIX}/dev/lib"
} > "${CONF}"

ldconfig

# 生成 /etc/profile.d/vstream.sh（不设 LD_LIBRARY_PATH，避免覆盖自适应复用）
cat > /etc/profile.d/vstream.sh <<EOF
# vStream environment (generated by postinst)
# LD_LIBRARY_PATH 不在此设置 —— 第三方依赖由 /etc/ld.so.conf.d/vstream.conf 自适应解析
export PATH="${PREFIX}/bin:\$PATH"
export PYTHONPATH="${PREFIX}/lib:\$PYTHONPATH"
EOF

# 输出安装摘要
echo "vStream installed to ${PREFIX}"
echo "  Dependencies reused from system: $(printf "%b" "${reuse_dirs}" | grep -c '/' || echo 0) dirs"
echo "  Dependencies using bundled dev/lib: ${fallback_count}"
if [ -n "${version_mismatch}" ]; then
  echo "  WARNING: SONAME mismatch (using bundled copy):"
  printf "%b" "${version_mismatch}"
fi
echo "Run 'source /etc/profile.d/vstream.sh' or start a new shell to use vStream."
echo "Note: Python and TensorRT must be provided by the runtime environment."
